{
  "name": "harebear-ui",
  "version": "0.13.0",
  "description": "Opinionated, pre-themed shadcn/ui component library for React 19 + Tailwind CSS v4. Admin, data, and AI chat building blocks, ready for agents.",
  "license": "MIT",
  "author": "Harrison Milbradt",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HMilbradt/harebear-ui.git"
  },
  "homepage": "https://github.com/HMilbradt/harebear-ui#readme",
  "bugs": "https://github.com/HMilbradt/harebear-ui/issues",
  "keywords": [
    "react",
    "tailwindcss",
    "shadcn",
    "radix",
    "ui",
    "components",
    "design-system",
    "admin",
    "dashboard",
    "ai",
    "chat",
    "llm",
    "agents"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./llms.txt": "./llms.txt",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "harebear-ui": "bin/harebear-ui.mjs"
  },
  "files": [
    "dist",
    "bin",
    "docs",
    "skills",
    "llms.txt",
    "AGENTS.md"
  ],
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "gen": "node scripts/gen-index.mjs && biome check --write src/index.ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "shots": "node scripts/screenshots.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && publint && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css ./llms.txt",
    "prepublishOnly": "pnpm check"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react-day-picker": "^10.0.2",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.21.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.6",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
